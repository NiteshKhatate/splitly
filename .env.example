# Server-only PostgreSQL connections. Use a pooled URL at runtime and a direct
# URL for Prisma migrations and schema operations.
DATABASE_URL="postgresql://USER:PASSWORD@POOLER_HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@DIRECT_HOST:5432/postgres"

# Existing authentication variables. Replace these placeholders locally.
NEXT_PUBLIC_SUPABASE_URL="https://PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="PUBLISHABLE_KEY"
SUPABASE_SECRET_KEY="SECRET_KEY"

# Required public origin used in authentication and invitation emails.
APP_URL="https://splitly.example.com"

# Scheduled email reminders. Vercel sends CRON_SECRET as a bearer token.
CRON_SECRET="GENERATE_A_LONG_RANDOM_SECRET"
RESEND_API_KEY="RESEND_API_KEY"
REMINDER_FROM_EMAIL="Splitly <reminders@example.com>"

# Optional dedicated non-production accounts for authenticated Playwright tests.
E2E_USER_EMAIL="e2e-owner@example.com"
E2E_USER_PASSWORD="TEST_ACCOUNT_PASSWORD"
E2E_MEMBER_EMAIL="e2e-member@example.com"
E2E_MEMBER_PASSWORD="TEST_ACCOUNT_PASSWORD"

# Optional server-side error-monitoring webhook. Payloads are PII-redacted.
ERROR_MONITORING_WEBHOOK_URL="https://monitoring.example.com/events"
ERROR_MONITORING_TOKEN="MONITORING_INGEST_TOKEN"

# Configure this as a GitHub Actions repository variable for the scheduled
# uptime workflow; it is not required by the application runtime.
PRODUCTION_HEALTHCHECK_URL="https://splitly.example.com/api/health"
